# Copy to .env for local runs. Never commit .env.

# Mode: stub (default, $0, no model calls) or live (Haiku-class, spend-capped).
CLAIMS_MODE=stub
# CLAIMS_MODE=live

# Required only when CLAIMS_MODE=live. Without it, live drafting refuses clearly
# (does not invent "live" output or silently fall back).
# ANTHROPIC_API_KEY=

# Haiku-class model id (must have a price entry so the spend cap can be enforced).
CLAIMS_MODEL=claude-haiku-4-5

# Hard daily spend cap for live mode (USD, UTC day). Enforced in code before each call.
CLAIMS_DAILY_SPEND_CAP_USD=1.00

# Optional paths / corpus pins
# CLAIMS_DB_PATH=data/claims.db
# CLAIMS_CORPUS_VERSION=1.0.0
# CLAIMS_PINNED_CORPUS_HASH=corpus-v1.0.0-seed42
